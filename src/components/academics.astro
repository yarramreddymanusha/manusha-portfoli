  {
    type: "Patent Publication",
    badge: "Patent 2026",
    title: "Health-Aware Predictive Mobility Intelligence System",
    issuer: "Official Patent Application Publication — App No. 202641087136 A",
    year: "2026",
    description: "Inventive system modeling health-aware mobility intelligence, integrating multi-factor telemetry with predictive algorithms for optimized and adaptive transit guidance.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-400"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
    badgeColor: "bg-amber-400/10 text-amber-300 border-amber-400/30",
  },
  {
