    institution: "New Horizon College of Engineering, Bangalore",
    affiliation: "Affiliated with Visvesvaraya Technological University (VTU), Belagavi",
    period: "2023 – 2027",
    status: "Undergraduate (Pursuing)",
    highlights: [
      "Core coursework: Data Structures & Algorithms, Object-Oriented Programming (Java/Python/C), Database Management Systems (MySQL).",
      "Hands-on project development in AI-integrated workflows, full-stack systems, and ETL data pipelines.",
      "Solid theoretical and practical foundation in database architecture, software engineering, and analytical modeling.",
    ],
  },
  {
    degree: "Class XII — Central Board of Secondary Education (CBSE)",
    institution: "Narayana e-Techno School, Bangalore",
    affiliation: "Senior Secondary Education (PCM)",
    period: "2021 – 2023",
    status: "Completed",
    highlights: [
      "Rigorous pre-engineering foundation in Mathematics, Physics, Chemistry, and Computer Science.",
      "Cultivated deep analytical thinking and competitive problem-solving skills.",
    ],
  },
