    issuer: "Grace Hopper Celebration India (GHCI)",
    year: "2025",
    description: "Advanced to Round 2 in a national-level competitive AI hackathon by designing and pitching an impactful, AI-enabled technological solution.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple-400"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
