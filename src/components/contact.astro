---
---

<section id="contact" class="w-full py-16 border-t border-[var(--border-subtle)]">
  <div class="max-w-5xl mx-auto">
    <div class="mb-10">
      <span class="text-xs font-semibold tracking-wider uppercase text-[var(--sec)]">Get In Touch</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--white)] mt-1">
        Contact Yarramreddy Manusha
      </h2>
      <p class="text-sm sm:text-base text-[var(--white-icon)] mt-2 max-w-xl">
        I am actively seeking software engineering and technology opportunities. Whether you have a question, a project collaboration, or an opening, feel free to connect!
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Contact Info Cards (5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        <!-- Location Card -->
        <div class="p-5 rounded-2xl bg-[var(--surface)] border border-[var(--border-subtle)] flex items-start gap-4 shadow-lg">
          <div class="p-3 rounded-xl bg-[var(--surface-muted)] border border-[var(--border-subtle)] text-[var(--sec)]">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <div class="text-xs text-[var(--white-icon-muted)] uppercase font-semibold">Location</div>
            <div class="text-base font-semibold text-[var(--text-primary)] mt-0.5">Bangalore, Karnataka, India</div>
            <div class="text-xs text-[var(--white-icon)] mt-0.5">Open to on-site & remote roles</div>
          </div>
        </div>

        <!-- Email Card -->
        <a 
          href="mailto:yarramreddymanusha@gmail.com" 
          class="p-5 rounded-2xl bg-[var(--surface)] border border-[var(--border-subtle)] hover:border-[var(--sec)]/50 transition-all duration-300 flex items-start gap-4 block group shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--surface)] active:scale-[0.99] motion-reduce:transition-none motion-reduce:active:scale-100"
        >
          <div class="p-3 rounded-xl bg-[var(--surface-muted)] border border-[var(--border-subtle)] text-[var(--sec)] group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <div>
            <div class="text-xs text-[var(--white-icon-muted)] uppercase font-semibold">Email</div>
            <div class="text-base font-semibold text-[var(--text-primary)] mt-0.5 group-hover:text-[var(--sec-bright)] transition-colors break-all">
              yarramreddymanusha@gmail.com
            </div>
            <div class="text-xs text-[var(--sec)] mt-0.5">Click to send direct email →</div>
          </div>
        </a>

        <!-- Phone Card -->
        <a 
          href="tel:+919620491391" 
          class="p-5 rounded-2xl bg-[var(--surface)] border border-[var(--border-subtle)] hover:border-[var(--sec)]/50 transition-all duration-300 flex items-start gap-4 block group shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--surface)] active:scale-[0.99] motion-reduce:transition-none motion-reduce:active:scale-100"
        >
          <div class="p-3 rounded-xl bg-[var(--surface-muted)] border border-[var(--border-subtle)] text-[var(--sec)] group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div>
            <div class="text-xs text-[var(--white-icon-muted)] uppercase font-semibold">Phone</div>
            <div class="text-base font-semibold text-[var(--text-primary)] mt-0.5 group-hover:text-[var(--sec-bright)] transition-colors">
              +91 96204 91391
            </div>
            <div class="text-xs text-[var(--sec)] mt-0.5">Call or WhatsApp →</div>
          </div>
        </a>

        <!-- Professional Profiles Pill Card -->
        <div class="p-5 rounded-2xl bg-[var(--surface)] border border-[var(--border-subtle)] shadow-lg">
          <div class="text-xs text-[var(--white-icon-muted)] uppercase font-semibold mb-3">Connect Online</div>
          <div class="flex gap-3">
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://github.com/yarramreddymanusha"
              class="flex-1 min-h-[44px] py-2.5 px-3 rounded-xl bg-[var(--surface-muted)] border border-[var(--border-subtle)] hover:border-[var(--sec)] text-xs font-semibold text-[var(--text-primary)] flex items-center justify-center gap-2 transition duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--surface)] active:scale-[0.98] motion-reduce:transition-none motion-reduce:active:scale-100"
            >
              <span>GitHub</span>
            </a>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://www.linkedin.com/in/yarramreddy-manusha-6392662b1"
              class="flex-1 min-h-[44px] py-2.5 px-3 rounded-xl bg-[var(--surface-muted)] border border-[var(--border-subtle)] hover:border-[var(--sec)] text-xs font-semibold text-[var(--text-primary)] flex items-center justify-center gap-2 transition duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--surface)] active:scale-[0.98] motion-reduce:transition-none motion-reduce:active:scale-100"
            >
              <span>LinkedIn</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Contact Message Form (7 cols) -->
      <div class="lg:col-span-7 p-6 sm:p-8 rounded-2xl bg-[var(--surface)] border border-[var(--border-subtle)] shadow-xl">
        <h3 class="text-xl font-bold text-[var(--text-primary)] mb-2">Send a Message</h3>
        <p class="text-xs sm:text-sm text-[var(--white-icon)] mb-6">
          Fill out this form to prepare an email to <strong class="text-[var(--text-primary)]">yarramreddymanusha@gmail.com</strong>.
        </p>

        <form
          id="contact-form"
          method="POST"
          class="flex flex-col gap-4"
        >
          <div>
            <label for="from_name" class="block text-xs font-medium text-[var(--white-icon)] mb-1.5">Your Name</label>
            <input
              id="from_name"
              type="text"
              name="name"
              placeholder="e.g. John Doe"
              required
              class="w-full px-4 py-3 bg-[var(--surface-input)] text-[var(--text-primary)] border border-[var(--border-subtle)] rounded-xl focus:outline-none focus:ring-2 focus:ring-[var(--sec)] text-sm transition-all"
            />
          </div>

          <div>
            <label for="reply_to" class="block text-xs font-medium text-[var(--white-icon)] mb-1.5">Your Email</label>
            <input
              id="reply_to"
              type="email"
              name="email"
              placeholder="e.g. john@example.com"
              required
              class="w-full px-4 py-3 bg-[var(--surface-input)] text-[var(--text-primary)] border border-[var(--border-subtle)] rounded-xl focus:outline-none focus:ring-2 focus:ring-[var(--sec)] text-sm transition-all"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-medium text-[var(--white-icon)] mb-1.5">Your Message</label>
            <textarea
              id="message"
              name="message"
              placeholder="Write your message or inquiry here..."
              rows="5"
              required
              class="w-full px-4 py-3 bg-[var(--surface-input)] text-[var(--text-primary)] border border-[var(--border-subtle)] rounded-xl focus:outline-none focus:ring-2 focus:ring-[var(--sec)] text-sm transition-all resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full min-h-[44px] py-3 px-6 bg-[var(--sec)] text-white dark:text-black font-semibold rounded-xl transition-all duration-300 hover:bg-[var(--sec-bright)] shadow-lg shadow-[var(--sec)]/15 text-sm md:text-base flex items-center justify-center gap-2 cursor-pointer mt-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--focus-ring)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--surface)] active:scale-[0.98] motion-reduce:transition-none motion-reduce:active:scale-100"
          >
               <span>Prepare Email</span>
          </button>
        </form>

        <div
          id="form-status"
          role="status"
          aria-live="polite"
          class="hidden mt-4 p-4 rounded-xl bg-[var(--sec)]/10 border border-[var(--sec)]/30 text-[var(--white)] text-sm flex items-center gap-3"
        >
          <span class="text-xl" aria-hidden="true">✉️</span>
          <span>Email draft prepared. Send it from your email app.</span>
        </div>

        <div
          id="form-fallback"
          role="alert"
          aria-live="assertive"
          class="hidden mt-4 p-4 rounded-xl bg-[var(--sec)]/10 border border-[var(--sec)]/30 text-[var(--white)] text-sm space-y-2"
        >
          <p>We couldn't prepare your email draft. Please email directly at: <a href="mailto:yarramreddymanusha@gmail.com" class="text-[var(--sec)] font-semibold underline">yarramreddymanusha@gmail.com</a></p>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="module" is:inline>
  const form = document.getElementById("contact-form");
  const statusBox = document.getElementById("form-status");
  const fallbackBox = document.getElementById("form-fallback");
  const submitBtn = document.getElementById("submit-btn");

  if (form && statusBox && fallbackBox && submitBtn) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const originalText = submitBtn.innerHTML;
      submitBtn.innerHTML = `<span>Sending...</span>`;
      submitBtn.disabled = true;

      const formData = new FormData(form);

      try {
        const name = String(formData.get("name") || "");
        const email = String(formData.get("email") || "");
        const message = String(formData.get("message") || "");
        const subject = `Portfolio Inquiry from ${name}`;
        const body = `Sender email: ${email}\n\nMessage:\n${message}`;
        const mailtoUrl = `mailto:yarramreddymanusha@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

        window.location.href = mailtoUrl;
        form.reset();
        statusBox.classList.remove("hidden");
        fallbackBox.classList.add("hidden");
      } catch (err) {
        statusBox.classList.add("hidden");
        fallbackBox.classList.remove("hidden");
      } finally {
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
      }
    });
  }
</script>
