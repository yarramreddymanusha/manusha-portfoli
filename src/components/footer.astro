---
import LikeButton from "../React/LikeButton.tsx";

const currentYear = new Date().getFullYear();
---

<footer class="w-full py-16 border-t border-[var(--border-subtle)] text-[var(--white)]">
  <div class="max-w-5xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10 items-start">
      <!-- Col 1: Social Links & Endorsement Like Button -->
      <div class="flex flex-col items-center md:items-start space-y-6">
        <div>
          <h4 class="text-xs uppercase font-semibold text-[var(--sec-bright)] tracking-wider mb-3">
            Connect & Endorse
          </h4>
          <div class="flex space-x-4">
            <a
              href="https://github.com/yarramreddymanusha"
              target="_blank"
              rel="noopener noreferrer"
              class="p-2.5 rounded-xl bg-[var(--surface)] border border-[var(--border-subtle)] text-[var(--white-icon)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-hover)] hover:border-[var(--sec)] transition-all shadow-sm"
              aria-label="GitHub Profile"
              title="GitHub Profile"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.501 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"></path>
              </svg>
            </a>

            <a
              href="https://www.linkedin.com/in/yarramreddy-manusha-6392662b1"
              target="_blank"
              rel="noopener noreferrer"
              class="p-2.5 rounded-xl bg-[var(--surface)] border border-[var(--border-subtle)] text-[var(--white-icon)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-hover)] hover:border-[var(--sec)] transition-all shadow-sm"
              aria-label="LinkedIn Profile"
              title="LinkedIn Profile"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
                <path d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z"></path>
              </svg>
            </a>

            <a
              href="mailto:yarramreddymanusha@gmail.com"
              class="p-2.5 rounded-xl bg-[var(--surface)] border border-[var(--border-subtle)] text-[var(--white-icon)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-hover)] hover:border-[var(--sec)] transition-all shadow-sm"
              aria-label="Direct Email"
              title="Email yarramreddymanusha@gmail.com"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"></path>
              </svg>
            </a>
          </div>
        </div>
        <LikeButton client:load />
      </div>

      <!-- Col 2: Architecture & Technologies -->
      <div class="flex flex-col items-center md:items-start space-y-4">
        <h4 class="text-xs uppercase font-semibold text-[var(--sec-bright)] tracking-wider">
          Portfolio Architecture
        </h4>
        <div class="grid grid-cols-1 gap-2.5 w-full max-w-xs text-xs text-[var(--white-icon)]">
          <div class="flex items-center gap-2.5 p-2 rounded-lg bg-[var(--surface-muted)] border border-[var(--border-subtle)]">
            <span class="w-2 h-2 rounded-full bg-[var(--sec)]"></span>
            <span>Framework: <strong class="text-[var(--text-primary)]">Astro v7 + React 19</strong></span>
          </div>
          <div class="flex items-center gap-2.5 p-2 rounded-lg bg-[var(--surface-muted)] border border-[var(--border-subtle)]">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            <span>Styling: <strong class="text-[var(--text-primary)]">Tailwind CSS + Custom Canvas</strong></span>
          </div>
          <div class="flex items-center gap-2.5 p-2 rounded-lg bg-[var(--surface-muted)] border border-[var(--border-subtle)]">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Location: <strong class="text-[var(--text-primary)]">Bangalore, India</strong></span>
          </div>
        </div>
      </div>

      <!-- Col 3: Coding Soundscape (Spotify Embed) -->
      <div class="flex flex-col items-center md:items-start space-y-3">
        <h4 class="text-xs uppercase font-semibold text-[var(--sec-bright)] tracking-wider">
          Focus Soundscape
        </h4>
        <div class="w-full max-w-xs rounded-xl overflow-hidden border border-[var(--border-subtle)] shadow-lg">
          <iframe
            title="Spotify Focus Soundscape Playlist"
            style="border-radius:12px; border:0;"
            src="https://open.spotify.com/embed/playlist/37i9dQZF1DXcBWIGoYBM5M?utm_source=generator&theme=0"
            class="w-full h-36"
            allowfullscreen=""
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy">
          </iframe>
        </div>
      </div>
    </div>

    <!-- Copyright & Attribution -->
    <div class="mt-12 pt-8 border-t border-[var(--border-subtle)] flex flex-col sm:flex-row items-center justify-between text-xs text-[var(--white-icon-muted)] gap-3">
      <div>
        <span>Copyright © {currentYear} <strong class="text-[var(--text-primary)] font-medium">Yarramreddy Manusha</strong>. All rights reserved.</span>
      </div>
      <div>
        <span>Design base adapted under MIT License &bull; Built with Astro & React</span>
      </div>
    </div>
  </div>
</footer>
