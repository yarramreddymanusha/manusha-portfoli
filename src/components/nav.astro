---
interface NavItem {
  label: string;
  href: string;
  icon: string;
}

const navItems: NavItem[] = [
  {
    label: "Home",
    href: "#home",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M21 20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V9.48907C3 9.18048 3.14247 8.88917 3.38606 8.69972L11.3861 2.47749C11.7472 2.19663 12.2528 2.19663 12.6139 2.47749L20.6139 8.69972C20.8575 8.88917 21 9.18048 21 9.48907V20ZM19 19V9.97815L12 4.53371L5 9.97815V19H19Z"></path></svg>`,
  },
  {
    label: "Projects",
    href: "#projects",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M4 5V19H20V7H11.5858L9.58579 5H4ZM12.4142 5H21C21.5523 5 22 5.44772 22 6V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V4C2 3.44772 2.44772 3 3 3H10.4142L12.4142 5Z"></path></svg>`,
  },
  {
    label: "Education",
    href: "#education",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2L1 7L12 12L21 7.90909V16H23V7L12 2ZM3.45455 7L12 3.18182L20.5455 7L12 10.8182L3.45455 7ZM12 14L4 9.63636V16C4 18.2091 7.58172 20 12 20C16.4183 20 20 18.2091 20 16V9.63636L12 14Z"></path></svg>`,
  },
  {
    label: "Honors",
    href: "#achievements",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M13.0049 16.9409C15.8291 16.4429 18 13.9744 18 11V3H6V11C6 13.9744 8.17088 16.4429 10.9951 16.9409L10.999 19H8V21H16V19H13V16.9409ZM8 5H16V11C16 13.2091 14.2091 15 12 15C9.79086 15 8 13.2091 8 11V5ZM4 5V9H2V5C2 3.89543 2.89543 3 4 3H5V5H4ZM20 5H21V3H20C18.8954 3 18 3.89543 18 5V9H20V5Z"></path></svg>`,
  },
  {
    label: "Contact",
    href: "#contact",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M21.7267 2.95694L16.2734 22.0432C16.1225 22.5716 15.7979 22.5956 15.5563 22.1126L11 13L1.9229 9.36919C1.41322 9.16532 1.41953 8.86022 1.95695 8.68108L21.0432 2.31901C21.5716 2.14285 21.8747 2.43866 21.7267 2.95694ZM19.0353 5.09647L6.81221 9.17085L12.4488 11.4255L15.4895 17.5068L19.0353 5.09647Z"></path></svg>`,
  },
];
---

<div class="flex justify-center w-full">
  <nav
    id="main-nav"
    aria-label="Main Navigation"
    class="fixed left-1/2 -translate-x-1/2 z-[100] bg-[var(--nav-bg)] border border-[var(--border-subtle)] backdrop-blur-xl transition-all duration-500 ease-in-out md:top-6 md:bottom-auto bottom-0 w-full md:w-auto md:min-w-[560px] md:max-w-3xl md:rounded-full shadow-2xl"
  >
    <div class="container mx-auto flex justify-center items-center py-1.5 px-2 md:py-2 md:px-6">
      <ul class="flex w-full justify-around md:justify-center md:gap-6 items-center">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex flex-col md:flex-row items-center justify-center gap-1 md:gap-2 text-[var(--white-icon)] hover:text-[var(--text-primary)] transition-colors text-[11px] sm:text-xs md:text-sm font-medium py-1.5 px-2 md:py-2 md:px-2.5 min-w-[44px] min-h-[44px] rounded-lg relative group focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)]"
              >
                <span class="flex items-center justify-center w-5 h-5 pointer-events-none" set:html={item.icon} />
                <span>{item.label}</span>
                <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-[var(--sec)] opacity-0 group-hover:opacity-100 transition-opacity hidden md:block"></span>
              </a>
            </li>
          ))
        }
        <li class="flex items-center">
          <div class="hidden md:block w-px h-5 bg-[var(--border-subtle)] mr-2" aria-hidden="true"></div>
          <button
            id="theme-toggle"
            type="button"
            aria-label="Switch to light theme"
            title="Toggle theme"
            class="flex flex-col md:flex-row items-center justify-center gap-1 md:gap-2 text-[var(--white-icon)] hover:text-[var(--text-primary)] transition-colors text-[11px] sm:text-xs md:text-sm font-medium py-1.5 px-2 md:py-2 md:px-2.5 min-w-[44px] min-h-[44px] rounded-lg relative group cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--sec)]"
          >
            <span class="flex items-center justify-center w-5 h-5 pointer-events-none" aria-hidden="true">
              <!-- Sun icon (shown in dark theme) -->
              <svg id="theme-icon-sun" class="w-5 h-5 hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 18C8.68629 18 6 15.3137 6 12C6 8.68629 8.68629 6 12 6C15.3137 6 18 8.68629 18 12C18 15.3137 15.3137 18 12 18ZM12 16C14.2091 16 16 14.2091 16 12C16 9.79086 14.2091 8 12 8C9.79086 8 8 9.79086 8 12C8 14.2091 9.79086 16 12 16ZM11 1H13V4H11V1ZM11 20H13V23H11V20ZM3.51472 4.92893L4.92893 3.51472L7.05025 5.63604L5.63604 7.05025L3.51472 4.92893ZM16.9497 18.364L18.364 16.9497L20.4853 19.0711L19.0711 20.4853L16.9497 18.364ZM19.0711 3.51472L20.4853 4.92893L18.364 7.05025L16.9497 5.63604L19.0711 3.51472ZM5.63604 16.9497L7.05025 18.364L4.92893 20.4853L3.51472 19.0711L5.63604 16.9497ZM23 11V13H20V11H23ZM4 11V13H1V11H4Z"/>
              </svg>
              <!-- Moon icon (shown in light theme) -->
              <svg id="theme-icon-moon" class="w-5 h-5 hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10 7C10 10.866 13.134 14 17 14C18.9584 14 20.729 13.1957 21.9995 11.8995C22 11.933 22 11.9665 22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C12.0335 2 12.067 2 12.1005 2.00049C10.8043 3.27098 10 5.04157 10 7ZM4 12C4 16.4183 7.58172 20 12 20C15.0583 20 17.7158 18.2839 19.062 15.7907C18.4025 15.9284 17.7126 16 17 16C12.0294 16 8 11.9706 8 7C8 6.28738 8.0716 5.5975 8.20934 4.93802C5.71611 6.28424 4 8.94168 4 12Z"/>
              </svg>
            </span>
            <span class="md:hidden">Theme</span>
          </button>
        </li>
      </ul>
    </div>
  </nav>
</div>

<style>
  nav {
    transform: translateX(-50%);
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  nav.scrolling {
    background-color: var(--nav-scrolling);
    border-color: var(--border-hover);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.4), 0 0 15px var(--sec-glow);
  }

  nav a.active {
    color: var(--text-primary) !important;
    background-color: var(--sec-glow);
  }

  @media (max-width: 767px) {
    nav {
      width: 100% !important;
      bottom: 0;
      border-radius: 1.25rem 1.25rem 0 0;
      border-bottom: none;
    }
  }
</style>

<script>
  const nav = document.getElementById("main-nav");
  const themeToggle = document.getElementById("theme-toggle");
  const sunIcon = document.getElementById("theme-icon-sun");
  const moonIcon = document.getElementById("theme-icon-moon");

  function syncThemeUI(theme: string) {
    if (theme === "light") {
      sunIcon?.classList.add("hidden");
      moonIcon?.classList.remove("hidden");
      themeToggle?.setAttribute("aria-label", "Switch to dark theme");
      themeToggle?.setAttribute("title", "Switch to dark theme");
    } else {
      sunIcon?.classList.remove("hidden");
      moonIcon?.classList.add("hidden");
      themeToggle?.setAttribute("aria-label", "Switch to light theme");
      themeToggle?.setAttribute("title", "Switch to light theme");
    }
  }

  const initialTheme = document.documentElement.getAttribute("data-theme") || "dark";
  syncThemeUI(initialTheme);

  themeToggle?.addEventListener("click", () => {
    const active = document.documentElement.getAttribute("data-theme") || "dark";
    const next = active === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    if (next === "dark") {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }
    try {
      localStorage.setItem("theme", next);
    } catch (e) {
      // storage unavailable
    }
    syncThemeUI(next);
  });

  function updateNav() {
    if (window.scrollY > 40) {
      nav?.classList.add("scrolling");
    } else {
      nav?.classList.remove("scrolling");
    }
  }

  window.addEventListener("scroll", updateNav, { passive: true });

  document.querySelectorAll('#main-nav a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      e.preventDefault();
      const target = e.currentTarget as HTMLAnchorElement;
      const targetId = target.getAttribute("href")?.substring(1) || "";
      const targetElement = document.getElementById(targetId);
      if (targetElement) {
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        targetElement.scrollIntoView({
          behavior: prefersReducedMotion ? "auto" : "smooth",
        });
      }
    });
  });

  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll("section[id], div[id='achievements']");
    const navLinks = document.querySelectorAll("nav a[href^='#']");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            navLinks.forEach((link) => link.classList.remove("active"));
            const id = entry.target.getAttribute("id");
            const activeLink = document.querySelector(`nav a[href="#${id}"]`);
            if (activeLink) {
              activeLink.classList.add("active");
            }
          }
        });
      },
      { threshold: 0.3 }
    );

    sections.forEach((section) => observer.observe(section));
  });
</script>
